legacy-peer-deps=true

# CI installs with pnpm, whose isolated node_modules can't resolve "phantom"
# (undeclared) transitive imports that npm's flat layout used to hoist — e.g.
# @web3auth/no-modal importing @toruslabs/ethereum-controllers, and
# scripts/generate-blog-manifest.mjs importing esbuild (a Vite transitive dep).
# A hoisted, npm-like layout makes those resolvable. This changes only the
# node_modules layout, NOT the locked dependency versions.
node-linker=hoisted
shamefully-hoist=true

# pnpm-lock.yaml has fallen behind package.json: wrangler, hash-wasm and
# @testing-library/dom are declared but unlocked — they went in via npm, so
# package-lock.json moved and this one didn't. pnpm defaults to
# --frozen-lockfile in CI and aborts outright on that, which means a cloud
# build can't install at all. The drift is purely additive, so resolving
# those three at install time is safe. Refresh the lockfile and this line
# can go.
frozen-lockfile=false
