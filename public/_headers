  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Resource-Policy: cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https: blob: data:; worker-src 'self' blob: data:; frame-src 'self' https://verify.walletconnect.com https://verify.walletconnect.org; base-uri 'self'; form-action 'self'; object-src 'none'; connect-src 'self' https://r2-pub.rork.com https://aigxuutjaqsywioxjefr.supabase.co wss://aigxuutjaqsywioxjefr.supabase.co https://api.dehub.io wss://api.dehub.io https://*.publicnode.com https://bsc-dataseed.binance.org https://bsc-dataseed1.binance.org https://data-seed-prebsc-1-s2.binance.org https://api.pimlico.io https://api.bscscan.com https://testnet.bscscan.com https://s2.coinmarketcap.com https://dehubcdn.ams3.cdn.digitaloceanspaces.com https://cdn.dehub.io https://*.walletconnect.com https://*.walletconnect.org

# The service worker must never be long-cached, or clients get stuck on an old
# SW that can't pick up new caching logic. Always revalidate. Scope stays root.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Deploy manifest behind the "new version available" toast. Must never be
# cached: a cached copy is indistinguishable from "you are already up to date",
# which is the one answer this file exists to disprove. ~150 bytes, and an open
# tab asks for it at most once a minute.
/version.json
  Cache-Control: no-store

# Hashed build chunks are content-addressed — cache for a year. Without this
# every repeat visit revalidates each chunk (ported from netlify.toml; was
# lost in the Cloudflare migration and live assets served max-age=0).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# LCP logo lives at site root (not hashed) — long cache; change filename when
# the asset changes.
/dehub-header-logo.png
  Cache-Control: public, max-age=31536000, immutable

# Same deal for the rest of the unhashed static art. Only /assets/* and the
# header logo had a rule, so everything else in /public was served
# `max-age=0, must-revalidate` and paid a revalidation round-trip on every
# visit — measured live against dehub.io in Aug 2026 on /radio/*, /brand/*,
# the icons and the loader GIF. None of these are content-hashed, so the
# convention above applies: CHANGE THE FILENAME when the asset changes.
/radio/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/osaka/*
  Cache-Control: public, max-age=31536000, immutable

/lovable-uploads/*
  Cache-Control: public, max-age=31536000, immutable

# Icons + install art. manifest.json deliberately stays short-lived: it is the
# one file a PWA re-reads to notice icon/name changes.
/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/dehub-icon.png
  Cache-Control: public, max-age=604800

/default-icon.png
  Cache-Control: public, max-age=604800

/default-icon-dark.png
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800

/dehub-loader.gif
  Cache-Control: public, max-age=31536000, immutable

/placeholder.svg
  Cache-Control: public, max-age=31536000, immutable

# The War theme's game runs in a sandboxed iframe WITHOUT allow-same-origin, so
# the frame has an opaque origin. Its entry is a `<script type="module">`, and
# module scripts are always fetched in CORS mode, so the request goes out with
# `Origin: null`. Without a matching Access-Control-Allow-Origin the browser
# drops the script silently: no error, no console output, just a black canvas.
# That is exactly how this failed in testing, twice.
#
# Granting the frame allow-same-origin would also fix it, but the game is served
# from this origin, so that would hand third party code real access to app
# storage, cookies and the parent DOM. This header keeps the sandbox strict
# instead. It is safe here because these are public static game assets with no
# credentials and nothing user specific.
# The rules are split at assets/ rather than written as one `/war-game/*`,
# which is what this was. Everything under assets/ is content-hashed by Vite,
# so a year of `immutable` is right for those — but index.html is NOT hashed
# and is the exact file the iframe asks for by name, so the blanket rule pinned
# it too and a re-vendored game would not have reached an existing visitor
# until 2027. Splitting the paths (rather than adding a narrower override) is
# deliberate: overlapping `_headers` rules combine, and two Cache-Control lines
# for one file is not a state worth reasoning about.
/war-game/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/war-game/index.html
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# The chess game is framed the same way, so it needs the same header for the
# same reason — its entry is a module script and an opaque-origin frame fetches
# those in CORS mode with `Origin: null`.
#
# It also fetches its armies (~44 MB of glTF and audio) from r2-pub.rork.com at
# runtime, which is why `connect-src` above lists that host. None of that is
# served from here; see public/chess-game/README.md.
/chess-game/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/chess-game/index.html
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/chess-game/favicon.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

# Arcade card art. Unhashed, so the convention for everything else in /public
# applies: CHANGE THE FILENAME when the capture changes.
/arcade/*
  Cache-Control: public, max-age=31536000, immutable

# The shared touch controls, loaded by the war and jungle entry documents. They
# sit outside both vendored directories so that re-vendoring a game — which for
# jungle is a straight copy over the top — cannot delete them.
#
# Revalidating and NOT immutable, for the same reason index.html is: the
# filename is not content-hashed, so a year of `immutable` would mean a fix to
# the feel of the stick never reaching anyone who has already played once.
#
# Access-Control-Allow-Origin is not strictly required today — this is a
# CLASSIC script, and those are fetched in no-cors mode, unlike the module
# entries above that this repo has twice been caught out by. It is here so that
# turning it into a module later cannot quietly resurrect that bug.
/arcade-touch/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate
