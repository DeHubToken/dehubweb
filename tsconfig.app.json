{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    /* src/lib/reserved-usernames.js is plain JS so CLOUDFLARE_WORKER_SEO.js —
       bundled by wrangler, not vite — can import the same list the app uses.
       It is the only .js under src/; checkJs stays off, so it is read for its
       exports and never type-checked. */
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}