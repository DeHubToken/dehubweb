[Unit]
Description=Stage recording and replay media
After=network-online.target
Wants=network-online.target

[Service]
User=dehub-dub
Group=dehub-dub
WorkingDirectory=/srv/dehub-stage-media/app
EnvironmentFile=/etc/dehub-dub.env
Environment=HOME=/srv/dehub-dub/cache
Environment=XDG_CACHE_HOME=/srv/dehub-dub/cache
Environment=NUMBA_CACHE_DIR=/srv/dehub-dub/cache/numba
Environment=HF_HOME=/srv/dehub-dub/cache
Environment=DUB_CPU_THREADS=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/dehub-dub/venv/bin/uvicorn stage_server:app --host 127.0.0.1 --port 7862 --workers 1
Restart=on-failure
RestartSec=10
Nice=15
CPUQuota=100%
MemoryMax=6G
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dehub-dub/cache

[Install]
WantedBy=multi-user.target
