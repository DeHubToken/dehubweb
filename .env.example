# Copy to .env and fill in. All values here are client-side (VITE_*) publishable keys.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# .env.development only:
# VITE_PAYMENTS_CLIENT_TOKEN=   (Stripe test publishable key)

# Origin of the deployed "Claude of Duty" build embedded by the War theme's
# game launcher. Leave blank to disable: the overlay then reports no signal
# instead of rendering a broken frame. The game is a separate deploy, embedded
# in a sandboxed iframe, so this is an origin and not a path.
VITE_WAR_GAME_URL=

# Base URL the Osaka theme loads its backplate video and soundtrack from. Those
# two files are ~23 MB and are deliberately kept out of git, so point this at a
# CDN in deploys (no trailing slash; `osaka-loop.mp4` and `osaka-ambience.mp3`
# are appended). Leave blank to use /osaka, i.e. public/osaka locally. If the
# files are missing the theme falls back to a CSS-only neon backdrop rather
# than a black screen - see public/osaka/README.md.
VITE_OSAKA_MEDIA_BASE=
