# Copy to .env and fill in. All values here are client-side (VITE_*) publishable keys.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# .env.development only:
# VITE_PAYMENTS_CLIENT_TOKEN=   (Stripe test publishable key)

# Origin of the deployed "Claude of Duty" build embedded by the War theme's
# game launcher. Leave blank to disable: the overlay then reports no signal
# instead of rendering a broken frame. The game is a separate deploy, embedded
# in a sandboxed iframe, so this is an origin and not a path.
VITE_WAR_GAME_URL=

# Optional override for where the Osaka theme loads its backplate video from.
# The video ships in the repo at public/osaka/osaka-loop.mp4, so this is only
# needed to serve it from a CDN instead. No trailing slash; `osaka-loop.mp4` is
# appended. Leave blank to use /osaka. See public/osaka/README.md.
VITE_OSAKA_MEDIA_BASE=

# WHIP (WebRTC) ingest endpoint for the browser "go live from camera" path.
# The stream key is appended, so no trailing slash. Leave blank to use
# Livepeer's public endpoint (https://livepeer.studio/webrtc); only set this to
# point at a self-hosted catalyst. Not a secret.
VITE_LIVEPEER_WHIP_URL=

# Hostname of the self-hosted live ingest (MediaMTX). Setting this is HALF of
# the cutover away from Livepeer — the other half is LIVE_INGEST_PROVIDER on
# the API, which decides where new streams are created. This side only teaches
# the client how to reach a stream that is already marked `mediamtx`, so it is
# inert on its own and safe to ship first. Ordering matters in exactly that
# direction: with the API flipped and this blank, a self-hosted stream would
# resolve to Livepeer URLs and play nothing. No scheme, no trailing slash.
# Not a secret.
VITE_MEDIAMTX_HOST=
