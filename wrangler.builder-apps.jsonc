{
  "name": "dehub-builder-apps",
  "main": "./workers/builder-apps/index.js",
  "compatibility_date": "2026-07-18",
  // Every DeHub Builder app on its own origin: https://<slug>.dhb.gg.
  // dhb.gg is a separate registrable domain from dehub.io on purpose — the
  // apps run AI-written code and must never share cookies, storage or link
  // trust with the main site.
  //
  // A route, not a custom domain (custom domains cannot be wildcards). It needs
  // the proxied wildcard DNS record `*.dhb.gg`, which the deploy workflow
  // ensures. The apex and www pass through untouched.
  "routes": [
    { "pattern": "*.dhb.gg/*", "zone_name": "dhb.gg" }
  ],
  "workers_dev": false
}
