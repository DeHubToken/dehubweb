{
  "name": "dehub-migration",
  "main": "./CLOUDFLARE_WORKER_SEO.js",
  "compatibility_date": "2026-07-18",
  // Bind alias hosts to the worker so their →apex 301s are served here and
  // the dead origins behind their DNS records are never contacted. The apex
  // stays on its dashboard-configured custom domain; this is additive.
  // dehub.net (+ all subdomains) = SEO domain-move redirects, served here
  // since the zone moved to Cloudflare (July 2026).
  // staging.dehub.io = the pre-release mirror. Same assets as the apex; the
  // worker's host guard stamps every response noindex so staging can never
  // outrank production.
  // legacy.dehub.io = the pre-2026 app, retired. Needs a proxied placeholder
  // DNS record on the zone for this route to fire at all.
  "routes": [
    { "pattern": "www.dehub.io/*", "zone_name": "dehub.io" },
    { "pattern": "staging.dehub.io/*", "zone_name": "dehub.io" },
    { "pattern": "legacy.dehub.io/*", "zone_name": "dehub.io" },
    { "pattern": "dehub.net/*", "zone_name": "dehub.net" },
    { "pattern": "*.dehub.net/*", "zone_name": "dehub.net" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // The Worker runs first for everything EXCEPT the folders below. Those are
    // plain files with no Worker logic behind them (no SSR, no redirects, no
    // per-route headers beyond public/_headers), so they are served straight
    // from assets and never bill an invocation. Negative patterns win over
    // "/*", and order does not matter.
    //
    // Deliberately still Worker-first:
    //   /assets/*          stale-deploy chunks must 404, not get the SPA shell
    //                      at 200 cached immutable for a year (see the
    //                      /assets/ branch in CLOUDFLARE_WORKER_SEO.js).
    //   /gods-eye-game/*   index.html gets its Cache-Control pinned in code.
    //   /arcade, /docs, /guides, /radio, /editor, /manual
    //                      share their prefix with SPA / SSR routes.
    // Trade-off on the excluded paths: mirror hosts (staging, www, dehub.net)
    // serve them as-is, without the apex 301 or the noindex stamp.
    "run_worker_first": [
      "/*",
      "!/media/*",
      "!/og/*",
      "!/sounds/*",
      "!/brand/*",
      "!/brand-kit/*",
      "!/osaka/*",
      "!/theme-icons/*",
      "!/war-game/*",
      "!/chess-game/*",
      "!/jungle-game/*",
      "!/street-slayer-game/*",
      "!/trenchstar-game/*"
    ]
  }
}
